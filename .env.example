# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=url_checker
DB_PASSWORD=url_checker
DB_NAME=url_checker

# `postgres` service name)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:${REDIS_PORT}

# API
API_PORT=3001

# Web: port, server-side API address (local dev), and the address the browser
# uses for live updates (SSE).
WEB_PORT=3000
API_URL=http://localhost:${API_PORT}
PUBLIC_API_URL=http://localhost:${API_PORT}

# Compose replicas. Keeping them here (rather than on the command line) means
# `podman compose down` sees the same values and removes every replica.
API_REPLICAS=1
WORKER_REPLICAS=1
